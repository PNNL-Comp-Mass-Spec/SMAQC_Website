{
    "name": "pnnl-comp-mass-spec/smaqc_website",
    "type": "project",
    "description": "PNNL Omics SMAQC Site",
    "homepage": "https://prismsupport.pnl.gov/smaqc/",
    "license": "MIT",
    "require": {
        "php": "^7.3 || ^8.0",
        "codeigniter4/framework": "^4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "codeigniter/phpstan-codeigniter": "^1.5",
        "phpstan/extension-installer": "^1.4"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@composer dump-autoload"
        ],
        "post-update-cmd": [
            "@composer dump-autoload"
        ]
    }
}
